# Apptainer definition that reuses the Docker image as its base (DRY: one recipe).
#
# Build options:
#   From a local Docker image (needs Docker + Apptainer on the same machine):
#       apptainer build tsc-marl.sif apptainer.def
#   From a registry instead (recommended; edit the From: line to your ref):
#       change Bootstrap/From below to  docker / ghcr.io/youruser/tsc-marl:tag
#
# For most users, scripts/build_sif.sh is simpler than this file. This .def
# exists so the conversion recipe (and the runtime env) is version-controlled.

Bootstrap: docker-daemon
From: tsc-marl:latest

%environment
    # Mirror the image's env so `apptainer run/exec` behaves like `docker run`.
    export SUMO_HOME=/opt/sumo
    export PATH=/opt/sumo/bin:$PATH
    export PYTHONPATH=/opt/LibSignal:$PYTHONPATH
    export CUBLAS_WORKSPACE_CONFIG=:4096:8

%runscript
    exec python /opt/smoke_test.py "$@"

%labels
    Name tsc-marl
    Description Portable MARL Traffic Signal Control env (SUMO + CityFlow + LibSignal + PyG)

%help
    MARL/TSC environment. Run the health check:
        apptainer exec --nv tsc-marl.sif python /opt/smoke_test.py
    On HPC, always pass --nv for GPU access and --bind your code/results dirs.
