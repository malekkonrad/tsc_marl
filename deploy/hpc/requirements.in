# Direct (top-level) Python deps for tsc-marl, layered on top of
# torch/PyG/SUMO/CityFlow (which are installed separately in the Dockerfile
# because they need custom package indexes / a source build).
#
# EDIT THIS FILE, then regenerate the locked requirements.txt with:
#   uv pip compile requirements.in -o requirements.txt \
#     --generate-hashes --python-version 3.10 --python-platform x86_64-unknown-linux-gnu
#
# numpy is held < 2.0 for the compiled-wheel (PyG/others) ABI.

